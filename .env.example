# Optional repository-root configuration. Free discovery works without this file.
APP_ENV=local
# Omit DATABASE_URL to use data/studio.sqlite3 under this repository.
# DATABASE_URL=sqlite:///D:/Code/Projects/Variance/data/studio.sqlite3
# ASSET_DIR=D:/Code/Projects/Variance/data/references
PUBLISH_ENABLED=false
DAILY_POST_CAP=3

# Free, keyless source extracts from Wikipedia; images use Wikimedia Commons.
RESEARCH_PROVIDER=wikipedia
# Optional Gemini mode: change RESEARCH_PROVIDER to gemini and set your own key.
# To stay free, use a Google API project without billing enabled. No paid fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional image generation: Cloudflare Workers Free account only.
# Confirm the account is NOT on Workers Paid before setting this flag true.
# Token requires Workers AI access. No token is sent to the browser.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_FREE_PLAN_CONFIRMED=false
