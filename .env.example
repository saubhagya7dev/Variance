# Optional repository-root configuration. Free discovery works without this file.
APP_ENV=local
# Omit DATABASE_URL to use data/studio.sqlite3 under this repository.
# DATABASE_URL=sqlite:///D:/Code/Projects/Variance/data/studio.sqlite3
# ASSET_DIR=D:/Code/Projects/Variance/data/references
PUBLISH_ENABLED=false
DAILY_POST_CAP=3

# Free, keyless source extracts from Wikipedia; images use Wikimedia Commons.
RESEARCH_PROVIDER=wikipedia
# Optional Gemini mode: change RESEARCH_PROVIDER to gemini and set your own key.
# To stay free, use a Google API project without billing enabled. No paid fallback.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Gemini IMAGE generation has NO published free API tier.
# Disabled by default, even when GEMINI_API_KEY is set for text features.
# Set true ONLY when you deliberately accept billable image API calls.
GEMINI_IMAGE_PAID_ENABLED=false
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1

# Optional Gemini caption drafting; use a project without billing enabled.
# Reuses GEMINI_API_KEY and GEMINI_MODEL. Local templates need no keys.
GEMINI_CAPTIONS_ENABLED=false

# Social account identity checks only; live publishing remains disabled.
# Set the version supported by your Meta app, e.g. v25.0; no automatic version choice.
META_GRAPH_VERSION=
# Instagram Login user token (not a Facebook Login token).
INSTAGRAM_ACCESS_TOKEN=
# Page token and matching numeric Page ID, not a personal profile token.
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
THREADS_ACCESS_TOKEN=
# OAuth 2.0 user-context token, not an app-only bearer token.
X_USER_ACCESS_TOKEN=
